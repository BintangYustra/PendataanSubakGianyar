<sql_create_table>CREATE TABLE `tb_subak` (
  `id_subak` int(5) NOT NULL AUTO_INCREMENT,
  `nama_subak` varchar(50) DEFAULT NULL,
  `kriteria_subak` enum('Subak Basah','Subak Abian') DEFAULT NULL,
  `nomor_akte_notaris` int(11) DEFAULT NULL,
  `npwp` int(11) DEFAULT NULL,
  `verifikasi` enum('Terverifikasi','Belum Terverifikasi','Data Ditolak','Data Tidak Dipakai','Data DiPerbarui') DEFAULT 'Belum Terverifikasi',
  `usul_saran_komentar` text DEFAULT NULL,
  PRIMARY KEY (`id_subak`)
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci</sql_create_table>
</table>
